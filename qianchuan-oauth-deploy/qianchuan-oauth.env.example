OCEANENGINE_APP_ID=your-oceanengine-app-id
OCEANENGINE_APP_SECRET=your-oceanengine-app-secret
OCEANENGINE_REDIRECT_URI=https://YOUR_PUBLIC_HOST/api/oceanengine/oauth/callback
OCEANENGINE_STATE_SECRET=replace-with-random-state-secret
OCEANENGINE_ADMIN_TOKEN=replace-with-random-admin-token
QIANCHUAN_CONTROL_TOKEN=replace-with-random-control-token
QIANCHUAN_BOOTSTRAP_ADMIN_USERNAME=admin@example.local
QIANCHUAN_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
OCEANENGINE_DB_PATH=/var/lib/qianchuan-oauth/qianchuan-oauth.sqlite3
OCEANENGINE_BIND_HOST=127.0.0.1
OCEANENGINE_BIND_PORT=18080
QIANCHUAN_DEFAULT_ADVERTISER_ID=11
QIANCHUAN_DEFAULT_SHOP_ID=1
QIANCHUAN_DEFAULT_SHOP_NAME=Demo Shop
